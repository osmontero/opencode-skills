{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "threatwinds": {
      "name": "ThreatWinds",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://apis.threatwinds.com/api/ai/v1",
        "timeout": 2700000,
        "headerTimeout": 2700000,
        "temperature": 1,
        "topP": 0.95,
        "topK": 20,
        "minP": 0.0,
        "presencePenalty": 0.0,
        "repetitionPenalty": 1.0
      },
      "models": {
        "silas-1.7-pro": {
          "name": "Silas 1.7 Pro",
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 997952,
            "input": 866880,
            "output": 131072
          }
        }
      }
    },
    "threatwinds-dev": {
      "name": "ThreatWinds Dev",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://apis.dev.threatwinds.com/api/ai/v1",
        "timeout": 2700000,
        "headerTimeout": 2700000,
        "temperature": 1,
        "topP": 0.95,
        "topK": 20,
        "minP": 0.0,
        "presencePenalty": 0.0,
        "repetitionPenalty": 1.0
      },
      "models": {
        "silas-1.7-pro": {
          "name": "Silas 1.7 Pro",
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 997952,
            "input": 866880,
            "output": 131072
          }
        }
      }
    }
  },
  "model": "threatwinds/silas-1.7-pro",
  "compaction": {
    "buffer": 137038,
    "keep": { "tokens": 40000 }
  },
  "instructions": ["~/.config/opencode/MEMORY.md", ".opencode/MEMORY.md"],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "firecrawl": {
        "type": "local",
        "command": ["npx", "-y", "firecrawl-mcp"],
        "environment": {
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
        }
      },
      "brave-search": {
        "type": "local",
        "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
        "environment": {
          "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
        }
      }
    }
  },
  "agents": {
    "plan": {
      "system": "{file:./prompts/plan.txt}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "docs/plans/*", "effect": "allow" },
        { "action": "edit", "resource": "docs/specs/*", "effect": "allow" }
      ]
    },
    "build": {
      "system": "{file:./prompts/build.txt}"
    }
  }
}
